# Supabase PostgreSQL Database URL
# Example: postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection example: postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase Storage Bucket Name (default: wild_rakib)
SUPABASE_STORAGE_BUCKET="wild_rakib"

# Initial Administrator Credentials (seeded into admin_users on db:seed)
ADMIN_EMAIL="admin@wildrahi.com"
ADMIN_PASSWORD="CHANGE_ME_IN_PRODUCTION"

# Admin Session Authentication Secret (min 32 characters, used to sign HttpOnly JWT session tokens)
AUTH_SECRET="CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_KEY_FOR_SESSION_SIGNING_12345"

# Optional App URL
APP_URL="http://localhost:3000"
